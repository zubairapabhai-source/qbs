{
  "expo": {
    "name": "Quran, Bible and Science",
    "slug": "quran-bible-science",
    "version": "0.1.8",
    "orientation": "portrait",
    "scheme": "qbs",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#042216"
    },
    "ios": {
      "bundleIdentifier": "com.divineseriesmobile.quranbiblescience",
      "buildNumber": "12",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Listen as you recite to find the Qur'\u0101nic verse.",
        "NSSpeechRecognitionUsageDescription": "Match your spoken Arabic to a verse.",
        "NSLocationWhenInUseUsageDescription": "Calculate accurate prayer times for your location.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "com.divineseriesmobile.quranbiblescience",
      "versionCode": 10,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#042216"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.WAKE_LOCK"
      ],
      "edgeToEdgeEnabled": true,
      "blockedPermissions": [
        "android.permission.ACTIVITY_RECOGNITION"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Listen as you recite to find the Qur'\u0101nic verse.",
          "speechRecognitionPermission": "Match your spoken Arabic to a verse.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Listen as you recite to find the Qur'\u0101nic verse."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1d92d471-406d-4f2f-bd6c-ca593e834923"
      }
    },
    "owner": "divineseries",
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/1d92d471-406d-4f2f-bd6c-ca593e834923"
    }
  }
}