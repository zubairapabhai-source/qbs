{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "local",
    "promptToConfigurePushNotifications": false
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_QBS_API_URL": "https://divine-series.onrender.com/q"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_QBS_API_URL": "https://divine-series.onrender.com/q"
      }
    },
    "production": {
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_QBS_API_URL": "https://divine-series.onrender.com/q",
        "SENTRY_ALLOW_FAILURE": "true",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6801619940",
        "ascApiKeyPath": "/app/secrets/AuthKey_J5UV2ND69J.p8",
        "ascApiKeyId": "J5UV2ND69J",
        "ascApiKeyIssuerId": "70b80a83-b611-4549-88da-7b4052012404",
        "appleTeamId": "JS9N5DAZKN",
        "bundleIdentifier": "com.divineseriesmobile.quranbiblescience"
      },
      "android": {
        "serviceAccountKeyPath": "/app/secrets/google-play-service-account.json",
        "track": "internal",
        "releaseStatus": "draft",
        "applicationId": "com.divineseriesmobile.quranbiblescience",
        "changesNotSentForReview": false
      }
    },
    "internal": {
      "android": {
        "serviceAccountKeyPath": "/app/secrets/google-play-service-account.json",
        "track": "internal",
        "releaseStatus": "draft",
        "applicationId": "com.divineseriesmobile.quranbiblescience"
      }
    },
    "closed": {
      "android": {
        "serviceAccountKeyPath": "/app/secrets/google-play-service-account.json",
        "track": "production",
        "releaseStatus": "completed",
        "applicationId": "com.divineseriesmobile.quranbiblescience"
      }
    }
  }
}